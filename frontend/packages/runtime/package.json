{
  "name": "golet-runtime",
  "version": "0.1.3",
  "description": "Typed access to the Golet runtime in the pages of Golet desktop apps",
  "keywords": [
    "golet",
    "desktop",
    "webview",
    "go"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HyperparameterSI/golet.git",
    "directory": "frontend/packages/runtime"
  },
